# MENU-28: the hosts the game talks to. Copy this file to .env (git ignores it) and fill in the real addresses;
# environment variables of the same name take precedence (CI writes them from repository variables).
# The server players connect to in a build.
WOTR_SERVER_URL=https://game.example.org
# The https origin update packages are downloaded from (ends with /).
WOTR_DOWNLOADS_URL=https://downloads.example.org/
# The server Play mode in the Unity Editor connects to (defaults to https://localhost:7443).
WOTR_EDITOR_SERVER_URL=https://localhost:7443
