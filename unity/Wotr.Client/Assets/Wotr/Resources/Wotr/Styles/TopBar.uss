/* UI-86: the top bar. UI-98: the Fellowship and Hunt summary moved to the corner tab (Styles/RightColumn.uss).
   UI-479 (owner, 2026-11-03: "the top bar we could try to slim a little, but without losing any information"): 36 points
   high and flat, in the menus' thin line. Every counter, die and state stays, and a click target stays at 32 points or more.
   Its height and colours are tokens of Styles/GameChrome.uss; Styles/Notices.uss and the Menu panel read the same height. */

.topbar {
    height: var(--game-topbar-height);
    min-height: var(--game-topbar-height);
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    /* The whole bar is an edge control that pans only on its outer rim (MapEdgePan). */
    padding: 0 18px 0 30px;
    background-color: var(--game-topbar-fill);
}

/* One muted gilt rule along the bar's foot. It stands on this layer, out of the bar's flow, so it takes no room from the
   bar's row; never takes the pointer. */
.topbar-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    /* UI-480 (owner, 2026-11-04): the gilt rule runs round the whole bar; it takes no layout. */
    border-width: 1px;
    border-color: var(--game-topbar-rule);
}

/* First child of the board stage: the bar's shadow falls on the map, under the docked panels. */
.topbar-shadow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 4px;
    background-image: resource("Wotr/Art/UI/surfaces/cast-shadow");
    -unity-background-scale-mode: stretch-to-fill;
}

.topbar > .phase {
    flex-shrink: 1;
    min-width: 0;
    margin: 0 4px 0 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 15px;
    color: rgb(236, 220, 174);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.8);
}

/* UI-263's crests, at the bar's size; they are 18 points wherever else a game is listed. */
.topbar .expansion-crest { width: 16px; height: 16px; }

.topbar-divider {
    width: 1px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 8px;
    background-color: var(--game-topbar-hairline);
}

/* Opponent action dice: medallions; special dice use framed tiles with their origin caption. */
#opponent-dice {
    height: 34px;
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
}
#opponent-dice .available-dice { flex-direction: row; flex-wrap: nowrap; align-items: center; flex-shrink: 0; }
#opponent-dice .opponent-side {
    margin: 0 8px 0 0;
    padding: 0;
    font-size: 11px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    color: rgb(201, 169, 100);
}
#opponent-dice .die {
    width: 29px;
    min-width: 29px;
    height: 29px;
    min-height: 29px;
    margin: 0 3px 0 0;
    padding: 0;
    font-size: 13px;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Wotr/Art/UI/dice/medallion");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 14.5px;
}
#opponent-dice .die:hover,
#opponent-dice .die:focus {
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Wotr/Art/UI/dice/medallion-hover");
}
#opponent-dice .die:active { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(222, 214, 196); }
#opponent-dice .die .action-symbol { left: 5px; top: 5px; width: 16px; height: 16px; }
/* UI-97: medallions in the enamel of their side with the face glyph of Styles/DicePanel.uss. */
#opponent-dice .die.die-free { background-image: resource("Wotr/Art/UI/dice/medallion-free"); }
#opponent-dice .die.die-shadow { background-image: resource("Wotr/Art/UI/dice/medallion-shadow"); }
#opponent-dice .die.die-free:hover, #opponent-dice .die.die-free:focus { background-image: resource("Wotr/Art/UI/dice/medallion-free-hover"); }
#opponent-dice .die.die-shadow:hover, #opponent-dice .die.die-shadow:focus { background-image: resource("Wotr/Art/UI/dice/medallion-shadow-hover"); }
#opponent-dice .die .die-face { left: 4px; top: 4px; right: 4px; bottom: 4px; }
#opponent-dice .die.special-die {
    width: 44px;
    min-width: 44px;
    height: 32px;
    min-height: 32px;
    margin-left: 2px;
    border-radius: 5px;
    background-image: resource("Wotr/Art/UI/dice/tile");
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    -unity-slice-left: 20;
    -unity-slice-scale: 0.5px;
}
#opponent-dice .die.special-die:hover,
#opponent-dice .die.special-die:focus { background-image: resource("Wotr/Art/UI/dice/tile-hover"); }
#opponent-dice .special-die .action-symbol { left: 12px; top: 1px; width: 16px; height: 16px; }
#opponent-dice .special-die .die-face { left: 13px; right: 13px; top: 2px; bottom: 12px; }
#opponent-dice .die-origin { bottom: 1px; height: 12px; font-size: 9px; color: rgb(233, 227, 207); }
#opponent-dice .die.selected { border-color: rgb(245, 212, 133); }
#opponent-dice .die.legal-target { border-color: rgb(255, 214, 112); }
#opponent-dice .die.resource-candidate { border-color: rgb(231, 193, 107); }

/* UI-267: the opponent's Lords special dice in their origin's art (Styles/DicePanel.uss), at the top bar's size. */
#opponent-dice .die.lords-die { width: 29px; min-width: 29px; height: 29px; min-height: 29px; border-radius: 14.5px; }
#opponent-dice .die.lords-die .die-origin-emblem { right: -3px; bottom: -3px; width: 12px; height: 12px; }
#opponent-dice .die.lords-die .die-remove-star { right: -3px; top: -3px; width: 11px; height: 11px; }
#opponent-dice .die.lords-die-vilya { background-image: resource("Wotr/Art/UI/dice/special-vilya"); }
#opponent-dice .die.lords-die-vilya:hover, #opponent-dice .die.lords-die-vilya:focus { background-image: resource("Wotr/Art/UI/dice/special-vilya-hover"); }
#opponent-dice .die.lords-die-nenya { background-image: resource("Wotr/Art/UI/dice/special-nenya"); }
#opponent-dice .die.lords-die-nenya:hover, #opponent-dice .die.lords-die-nenya:focus { background-image: resource("Wotr/Art/UI/dice/special-nenya-hover"); }
#opponent-dice .die.lords-die-narya { background-image: resource("Wotr/Art/UI/dice/special-narya"); }
#opponent-dice .die.lords-die-narya:hover, #opponent-dice .die.lords-die-narya:focus { background-image: resource("Wotr/Art/UI/dice/special-narya-hover"); }
#opponent-dice .die.lords-die-balrog { background-image: resource("Wotr/Art/UI/dice/special-balrog"); }
#opponent-dice .die.lords-die-balrog:hover, #opponent-dice .die.lords-die-balrog:focus { background-image: resource("Wotr/Art/UI/dice/special-balrog-hover"); }
#opponent-dice .die.lords-die-gothmog { background-image: resource("Wotr/Art/UI/dice/special-gothmog"); }
#opponent-dice .die.lords-die-gothmog:hover, #opponent-dice .die.lords-die-gothmog:focus { background-image: resource("Wotr/Art/UI/dice/special-gothmog-hover"); }

/* Opponent counters on the bar itself (UI-479), pushed right with the status, Menu and plaques.
   UI-98: each counter is its icon and number; the caption stays in the counter's description. */
.opponent-summary {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}
.summary-chip { height: 24px; flex-direction: row; align-items: center; padding: 0 5px; }
.summary-icon { width: 18px; height: 18px; flex-shrink: 0; margin-right: 4px; -unity-background-scale-mode: stretch-to-fill; }
.summary-icon-cards { background-image: resource("Wotr/Art/UI/icons/cards"); }
.summary-icon-rings { background-image: resource("Wotr/Art/UI/icons/ring"); }
.summary-icon-spent { background-image: resource("Wotr/Art/UI/icons/spent"); }
.summary-icon-out { background-image: resource("Wotr/Art/UI/icons/out"); }
/* UI-344 (D3): the opponent's expansion tokens, with the tokens' own art. */
.summary-icon-ruler { background-image: resource("Wotr/Art/UI/tokens/ruler-token-free"); }
.summary-icon-dismay { background-image: resource("Wotr/Art/UI/tokens/ruler-token-shadow"); }
.summary-icon-council { background-image: resource("Wotr/Art/UI/tokens/council-politics-council"); }
.summary-text { flex-direction: column; justify-content: center; }
/* UI-432 (owner's rule, UI-430): the Free Peoples card counter Worn with Sorrow and Toil may discard a random card from
   wears the red of a card to discard (UI-222, UI-430): a red rim on a red plate, breathing with the summary's pulse. Its
   rim takes the place of its padding and, UI-479, as the only counter a click can reach it stands 32 points high over
   margins that take the difference back, so the bar does not move; no filter. */
#board-screen .opponent-summary .summary-chip.discard-target {
    height: 32px;
    margin: -4px 0;
    padding: 0 3px;
    border-width: 2px;
    border-radius: 6px;
    border-color: rgb(236, 72, 48);
    background-color: rgba(128, 26, 20, 0.55);
}
.motion-enabled #board-screen .opponent-summary .summary-chip.discard-target {
    transition-property: border-color, background-color;
    transition-duration: 750ms;
    transition-timing-function: ease-in-out-sine;
}
.motion-enabled #board-screen .opponent-summary.choice-glow-pulse .summary-chip.discard-target {
    border-color: rgba(236, 72, 48, 0.4);
    background-color: rgba(80, 18, 14, 0.3);
}
#board-screen .opponent-summary .summary-chip.discard-target.pressed { translate: 0 1px; }
.summary-caption {
    display: none;
    height: 13px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-text-align: lower-left;
    color: rgb(201, 184, 142);
}
.summary-value {
    height: 18px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(241, 230, 196);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.8);
}
.summary-divider {
    width: 1px;
    height: 18px;
    flex-shrink: 0;
    background-color: var(--game-topbar-hairline);
}

.topbar > .muted {
    flex-shrink: 0;
    max-width: 96px;
    margin: 0 8px;
    /* The longest status takes two lines, which fit the bar only without the theme's padding. */
    padding: 0;
    white-space: normal;
    font-size: 11px;
}

#open-board-menu {
    width: 64px;
    min-width: 64px;
    height: 32px;
    min-height: 32px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 15px;
    border-width: 0;
    border-radius: 0;
    /* UI-479: a thin 28-point button by its picture, while the 32 points of its element stay the click target. The picture
       stands whole, because UI Toolkit draws a sliced picture over the whole element, whatever its background-size. */
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    -unity-slice-left: 0;
    background-size: 100% 28px;
    background-repeat: no-repeat;
    background-position-y: center;
}

/* Narrow bars keep icons, values and plaques; spacing tightens and the dice owner label gives way. */
.topbar-compact .summary-chip { padding: 0 3px; }
.topbar-compact .summary-icon { margin-right: 2px; }
#board-screen .topbar-compact .opponent-summary .summary-chip.discard-target { padding: 0 1px; }
.topbar-compact #opponent-dice .opponent-side { display: none; }
.topbar-compact > .muted { margin: 0 5px; }
.topbar-compact { padding-left: 28px; }
.topbar-compact .topbar-divider { margin: 0 4px; }
.topbar-compact #opponent-dice .die { width: 28px; min-width: 28px; height: 28px; min-height: 28px; margin-right: 2px; border-radius: 14px; }
.topbar-compact #opponent-dice .die .action-symbol { left: 5px; top: 5px; width: 14px; height: 14px; }
.topbar-compact #opponent-dice .die .die-face { left: 4px; top: 4px; right: 4px; bottom: 4px; }
/* Special dice keep their 32-point minimum target and their tile. */
.topbar-compact #opponent-dice .die.special-die { width: 42px; min-width: 42px; height: 32px; min-height: 32px; border-radius: 5px; }
.topbar-compact #opponent-dice .special-die .action-symbol { left: 12px; top: 1px; width: 16px; height: 16px; }
.topbar-compact #open-board-menu { width: 56px; min-width: 56px; }
/* UI-273: the opponent's Ruler die keeps its crown; a die discarded after the roll stays dimmed. */
#opponent-dice .die.ruler-die > .ruler-crown { top: -5px; translate: -7px 0; width: 14px; height: 9px; }
/* ART-07: the opponent's Ruler die in its round royal art, as a Lords special die. */
#opponent-dice .die.ruler-die { width: 29px; min-width: 29px; height: 29px; min-height: 29px; border-radius: 14.5px; }
#opponent-dice .die.ruler-die.die-free { background-image: resource("Wotr/Art/UI/dice/special-ruler-free"); }
#opponent-dice .die.ruler-die.die-free:hover { background-image: resource("Wotr/Art/UI/dice/special-ruler-free-hover"); }
#opponent-dice .die.ruler-die.die-free:focus { background-image: resource("Wotr/Art/UI/dice/special-ruler-free-hover"); }
#opponent-dice .die.ruler-die.die-free.resource-candidate { background-image: resource("Wotr/Art/UI/dice/special-ruler-free-lit"); }
#opponent-dice .die.ruler-die.die-free:active { background-image: resource("Wotr/Art/UI/dice/special-ruler-free-pressed"); }
#opponent-dice .die.ruler-die.die-shadow { background-image: resource("Wotr/Art/UI/dice/special-ruler-shadow"); }
#opponent-dice .die.ruler-die.die-shadow:hover { background-image: resource("Wotr/Art/UI/dice/special-ruler-shadow-hover"); }
#opponent-dice .die.ruler-die.die-shadow:focus { background-image: resource("Wotr/Art/UI/dice/special-ruler-shadow-hover"); }
#opponent-dice .die.ruler-die.die-shadow.resource-candidate { background-image: resource("Wotr/Art/UI/dice/special-ruler-shadow-lit"); }
#opponent-dice .die.ruler-die.die-shadow:active { background-image: resource("Wotr/Art/UI/dice/special-ruler-shadow-pressed"); }
#opponent-dice .die.ruler-discarded { opacity: 0.45; }

/* UI-499: the ranked game's clock. A fixed width, so a change of owner or digit moves nothing in the bar. */
.topbar > .move-clock-box {
    flex-shrink: 0;
    width: 118px;
    height: 34px;
    margin: 0 6px 0 2px;
    justify-content: center;
    align-items: center;
}
.move-clock-box > .move-clock {
    margin: 0;
    padding: 0;
    white-space: nowrap;
    font-size: 14px;
    color: rgb(236, 220, 174);
    -unity-text-align: middle-center;
}
.move-clock-box > .move-clock.move-clock-warning { color: rgb(244, 96, 72); }
/* UI-504: under the time, only when something is wrong. */
.move-clock-box > .move-clock-status {
    margin: 0;
    padding: 0;
    white-space: nowrap;
    font-size: 11px;
    color: rgb(240, 190, 130);
    -unity-text-align: middle-center;
}

/* UI-500: beside the clock, small; the banner and the veils of a paused game. */
.topbar > .move-clock-pause {
    flex-shrink: 0;
    width: 50px;
    height: 24px;
    min-height: 24px;
    margin: 0 2px 0 0;
    padding: 0;
    font-size: 12px;
}
.pause-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.pause-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.38);
}
.pause-host { position: absolute; }
.pause-banner-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    flex-direction: row;
    justify-content: center;
}
.pause-banner {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 8px 0 18px;
    border-width: 1px;
    border-color: rgb(176, 148, 88);
    border-radius: 2px;
    background-color: rgb(28, 24, 18);
}
.pause-banner-text {
    margin: 0 16px 0 0;
    padding: 0;
    font-size: 16px;
    color: rgb(236, 220, 174);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
}
.pause-resume { width: 96px; height: 32px; min-height: 32px; margin: 0; padding: 0; font-size: 14px; }
