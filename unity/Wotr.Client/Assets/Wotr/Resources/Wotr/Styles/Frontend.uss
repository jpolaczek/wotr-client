.frontend .status-message {
    white-space: normal;
    flex-shrink: 0;
}
.frontend .login-card {
    max-width: 590px;
    padding-top: 24px;
    padding-bottom: 24px;
}
.frontend .login-card .row {
    flex-wrap: wrap;
}
.frontend .login-card .row .action {
    flex-grow: 1;
}

.frontend .menu-lists { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.frontend .menu-lists > VisualElement { flex-grow: 1; flex-basis: 50%; min-width: 0; min-height: 0; padding: 8px; }
.frontend .row { flex-wrap: wrap; flex-shrink: 0; }
.frontend .saved-games-panel { flex-grow: 1; min-height: 0; max-height: 95%; }
.frontend .frontend-form { padding: 16px; }
.frontend .frontend-form .unity-text-field { margin-bottom: 12px; }
.frontend .action { white-space: normal; }

/* MENU-16: the margin keeps the credit line clear under a tall waiting room. */
.frontend .waiting-panel { max-width: 94%; max-height: 94%; margin-bottom: 20px; }
.frontend .waiting-panel .unity-label { white-space: normal; }
.frontend .waiting-panel .title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* TEST-03: the test scenario list replaces the game lists like Host game; rows read like saved games. */
.frontend .test-scenario-list { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.frontend .test-scenario-list .saved-games-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: none; }
.frontend .test-scenario-hint { white-space: normal; margin-bottom: 8px; color: rgb(176, 164, 136); font-size: 14px; }
/* TEST-09: three fixed tabs over the list; the open one wears the selected button art. */
.frontend .test-scenario-tabs,
.frontend .menu-tabs { flex-direction: row; flex-shrink: 0; margin: 0 0 6px 0; }
.frontend .test-scenario-tab,
.frontend .menu-tab { flex-grow: 1; flex-basis: 0; min-width: 0; height: 34px; min-height: 34px; margin: 0 6px 0 0;
    padding: 0 6px; font-size: 15px; white-space: nowrap; -unity-text-align: middle-center; }
.frontend .test-scenario-tab:last-child,
.frontend .menu-tab:last-child { margin-right: 0; }
/* TEST-10: the three expansion tabs are narrow, so the card tabs keep their whole names. */
.frontend .test-scenario-tab.test-scenario-tab-module { flex-grow: 0; flex-basis: auto; width: 72px; }
/* UI-295: the search by name sits under the tabs; its × clears it. */
.frontend .test-scenario-search-row { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 0 6px 0; }
.frontend .test-scenario-list .test-scenario-search { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 6px 0 0; }
.frontend .test-scenario-none { margin: 10px 0; white-space: normal; color: rgb(190, 180, 156); }
.frontend .test-scenario-group { margin: 10px 0 4px 0; font-size: 14px; -unity-font-definition: resource("Wotr/Fonts/Alegreya-SemiBold"); color: rgb(222, 198, 146); }
.frontend .test-scenario { flex-direction: column; align-items: stretch; margin: 2px 0; padding: 6px 10px; }
/* UI-470 (owner, 2026-11-03): a scenario is a list row (frontend/row), not a heavy button plate. */
.frontend .test-scenario {
    background-image: resource("Wotr/Art/UI/frontend/row");
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-left: 16;
    -unity-slice-scale: 0.5px;
}
.frontend .test-scenario:hover { background-image: resource("Wotr/Art/UI/frontend/row-hover"); }
.frontend .test-scenario-title { -unity-font-definition: resource("Wotr/Fonts/Alegreya-SemiBold"); color: rgb(240, 228, 198); -unity-text-align: middle-left; }
.frontend .test-scenario-description { white-space: normal; -unity-text-align: middle-left; font-size: 13px; color: rgb(190, 180, 156); }


/* MENU-11: the main menu — the dimmed map under a masthead, one framed window for the current list or form and a
   framed column of actions on its right. Sizes are fixed (the window and the column never change size between
   pages); only a screen too small for them lets the window shrink. Every action keeps its place. */
.main-menu {
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgb(17, 15, 14);
}
/* MENU-15: every screen before the board (sign-in, the main menu, the waiting room) stands on the same map. */
.frontend .frontend-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: resource("MapCanvas/terrain");
    -unity-background-scale-mode: scale-and-crop;
    /* UI-470 (owner, 2026-11-03): a little dimmer, so the thin-line cards stand clear of the map. */
    -unity-background-image-tint-color: rgb(72, 66, 56);
}
/* MENU-16: the original game's designers, one quiet line centred on the bottom edge, below every panel. */
.frontend .frontend-credits {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 16px;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: rgb(196, 182, 148);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}
.main-menu .menu-page {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 16px 16px 20px 16px;
    align-items: center;
    justify-content: center;
}
.main-menu .menu-masthead {
    flex-shrink: 0;
    align-items: center;
    margin-bottom: 12px;
}
.main-menu .menu-title {
    font-size: 40px;
    letter-spacing: 8px;
    color: rgb(234, 210, 150);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
    -unity-text-align: middle-center;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
}
.main-menu .menu-player {
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(196, 184, 156);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
}
.main-menu .menu-body {
    flex-direction: row;
    width: 980px;
    max-width: 100%;
    height: 540px;
    flex-shrink: 1;
    min-height: 0;
}

/* The window. UI-470 (owner, 2026-11-03): the menus' thin card (frontend/card) instead of the board's gilt frame,
   and no lacquer band: the page's name stands centred in spaced capitals over a hairline with a tiny lozenge
   (frontend/divider); Refresh keeps its place at the header's right end. */
.main-menu .menu-window {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    margin-right: 14px;
    padding: 10px 16px 16px 16px;
    background-image: resource("Wotr/Art/UI/frontend/card");
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    -unity-slice-left: 24;
    -unity-slice-scale: 0.5px;
}
.main-menu .menu-window-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 40px;
    margin-bottom: 8px;
    /* The left padding matches Refresh and its gap, so the centred title is centred in the window. */
    padding: 0 6px 0 34px;
    background-image: resource("Wotr/Art/UI/frontend/divider");
    background-size: 200px 8px;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: bottom;
}
.main-menu .menu-window-title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 18px;
    letter-spacing: 3px;
    color: rgb(232, 207, 146);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.main-menu .menu-lists { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.main-menu .menu-lists > .menu-list-page { flex-grow: 1; flex-shrink: 1; flex-basis: auto; min-height: 0; padding: 0; }
.main-menu .menu-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; max-height: none; }
.main-menu .menu-empty,
.main-menu #public-games-empty {
    margin: 12px 8px;
    font-size: 16px;
    color: rgb(190, 184, 160);
    white-space: normal;
}

/* A list row: a quiet thin-line field (UI-470: frontend/row), an emblem, the name over its detail and the seat or state
   on the right. */
.main-menu .menu-row {
    flex-direction: row;
    align-items: center;
    height: 60px;
    min-height: 60px;
    margin: 0 4px 6px 0;
    padding: 0 16px 0 10px;
    background-image: resource("Wotr/Art/UI/frontend/row");
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-left: 16;
    -unity-slice-scale: 0.5px;
    -unity-text-align: middle-left;
}
.main-menu .menu-row:hover { background-image: resource("Wotr/Art/UI/frontend/row-hover"); }
/* UI-470: a row that is a button keeps the row's look while held; Interaction.uss sinks and darkens it. */
.main-menu .unity-button.action.menu-row.pressed,
.main-menu .saved-match .unity-button.action.resume-match.pressed,
.main-menu .side-choice > .unity-button.action.side-card.pressed,
.frontend .unity-button.action.test-scenario.pressed {
    background-image: resource("Wotr/Art/UI/frontend/row-hover");
    -unity-background-image-tint-color: rgb(196, 186, 166);
}
.main-menu .menu-row-emblem {
    width: 34px;
    height: 34px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.main-menu .menu-row-emblem.side-free { background-image: resource("Wotr/Art/UI/icons/ring"); }
.main-menu .menu-row-emblem.side-shadow { background-image: resource("Wotr/Art/UI/dice/faces/eye"); }
.main-menu .menu-row-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.main-menu .menu-row-title {
    font-size: 17px;
    color: rgb(245, 232, 196);
    -unity-font-definition: resource("Wotr/Fonts/Alegreya-SemiBold");
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.main-menu .menu-row-detail {
    font-size: 14px;
    color: rgb(190, 184, 160);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.main-menu .menu-row-action {
    flex-shrink: 0;
    margin-left: 12px;
    font-size: 15px;
    color: rgb(232, 204, 130);
    -unity-font-definition: resource("Wotr/Fonts/Alegreya-SemiBold");
}
.main-menu .own-room-row { font-size: 16px; padding-left: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* OBS-04: Play and Observe keep their places at the end of every open game's row. */
.main-menu .public-room-row { flex-direction: row; align-items: center; }
.main-menu .public-room-row:hover { background-image: resource("Wotr/Art/UI/frontend/row"); }
.main-menu .public-room-action { width: 92px; height: 34px; min-height: 34px; margin-left: 8px; flex-shrink: 0; font-size: 15px; }
/* UI-262: the name and its detail line are a centred block of fixed line heights inside the row's frame (the labels'
   default margins and padding pushed the name onto the top rim and the detail onto the bottom one); long text ends
   with an ellipsis and the row's tooltip holds all of it. */
.main-menu .menu-row-text { justify-content: center; height: 44px; overflow: hidden; }
.main-menu .menu-row-title { height: 22px; margin: 0; padding: 0; -unity-text-align: middle-left; }
.main-menu .menu-row-detail { height: 18px; margin: 2px 0 0 0; padding: 0; -unity-text-align: middle-left; }

/* Saved games keep their row (resume and Changes) in the window's frame and type. */
.main-menu .saved-match { min-height: 76px; margin: 0 4px 6px 0; }
.main-menu .saved-match .resume-match {
    padding: 6px 14px;
    background-image: resource("Wotr/Art/UI/frontend/row");
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-left: 16;
    -unity-slice-scale: 0.5px;
}
.main-menu .saved-match .resume-match:hover { background-image: resource("Wotr/Art/UI/frontend/row-hover"); }
.main-menu .saved-match-heading { font-size: 17px; color: rgb(245, 232, 196); }
.main-menu .saved-match-detail { font-size: 14px; color: rgb(190, 184, 160); }
/* UI-470: a game waiting for your decision keeps its gold mark on the left, now a hairline-thin 2 points. */
.main-menu .saved-match.your-decision .resume-match { border-left-width: 2px; border-left-color: rgb(220, 189, 120); }

/* The test scenarios fill the same window. */
.main-menu .menu-window > .frontend-form { flex-grow: 1; padding: 8px 12px; }
.main-menu .menu-window > .frontend-form > .title { display: none; }
.main-menu .menu-window > .frontend-form .row { margin-top: 8px; }

/* MENU-30: Host a game, every control in a fixed place: the name row, the two side cards (as the waiting room's
   seats), the visibility segments, two lines of notes and the footer with Back and Create game. */
.main-menu .host-form { flex-grow: 1; padding: 6px 8px 0 8px; }
.main-menu .host-field { flex-direction: row; align-items: center; flex-shrink: 0; height: 40px; margin-bottom: 10px; }
.main-menu .host-label {
    width: 150px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(214, 198, 160);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
    -unity-text-align: middle-left;
}
.main-menu .host-heading { width: auto; height: 22px; margin-bottom: 6px; }
.main-menu .host-control { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0; }
.main-menu #room-name.host-control { height: 36px; }
.main-menu .host-segments { flex-direction: row; flex-grow: 0; }
.main-menu .host-segments > .host-segment { width: 120px; height: 36px; min-height: 36px; margin: 0 6px 0 0; font-size: 16px; }
.main-menu .host-note { flex-shrink: 0; height: 20px; margin: 0 0 4px 150px; padding: 0; font-size: 14px; color: rgb(190, 184, 160); }
.main-menu .host-footer { flex-direction: row; align-items: center; flex-shrink: 0; height: 44px; margin-top: auto; margin-bottom: 4px; }
.main-menu .host-footer > .host-back { width: 120px; height: 42px; min-height: 42px; margin: 0; font-size: 17px; }
.main-menu .host-footer > .host-status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 12px;
    font-size: 14px;
    color: rgb(236, 160, 140);
    white-space: normal;
    -unity-text-align: middle-center;
}
.main-menu .host-footer > .host-submit { width: 180px; height: 42px; min-height: 42px; margin: 0; font-size: 17px; }

/* MENU-30/MENU-31: a side as a card in the menu's frame; the chosen one is lit and ringed in gilt. */
.main-menu .side-choice { flex-direction: row; flex-shrink: 0; height: 112px; margin: 0 -4px 12px -4px; }
.main-menu .side-choice > .side-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: auto;
    margin: 0 4px;
    padding: 12px 16px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Wotr/Art/UI/frontend/row");
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-left: 16;
    -unity-slice-scale: 0.5px;
}
.main-menu .side-choice > .side-card:hover { background-image: resource("Wotr/Art/UI/frontend/row-hover"); }
/* UI-470: the chosen side is lit by its own thin gold line and warm field (frontend/row-selected), not a thick ring. */
.main-menu .side-choice > .side-card.selected {
    background-image: resource("Wotr/Art/UI/frontend/row-selected");
    border-width: 0;
}
.main-menu .side-card-heading { flex-direction: row; align-items: center; margin-bottom: 6px; }
.main-menu .side-card-heading .menu-row-emblem { width: 36px; height: 36px; }
.main-menu .side-card-name {
    margin: 0;
    padding: 0;
    font-size: 16px;
    letter-spacing: 2px;
    color: rgb(241, 223, 166);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
    -unity-text-align: middle-left;
}
.main-menu .side-card-detail { margin: 0; padding: 0; font-size: 14px; color: rgb(206, 194, 164); -unity-font-definition: resource("Wotr/Fonts/Alegreya-Regular"); white-space: normal; -unity-text-align: upper-left; }
/* MENU-31: the demo page's lines above and below the side cards. */
.main-menu .demo-note { flex-shrink: 0; margin: 0 0 12px 0; padding: 0; font-size: 15px; color: rgb(214, 198, 160); white-space: normal; }

/* The action column: the same card (UI-470: frontend/card); the open page's action wears the selected button art. */
.main-menu .menu-actions {
    width: 250px;
    flex-shrink: 0;
    padding: 16px;
    background-image: resource("Wotr/Art/UI/frontend/card");
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    -unity-slice-left: 24;
    -unity-slice-scale: 0.5px;
}
/* REPLAY-04: 38 px rows with 4 px between, so Replays fits in the column above Sign out and Quit game. */
.main-menu .menu-action {
    height: 38px;
    min-height: 38px;
    margin: 0 0 4px 0;
    padding-left: 18px;
    font-size: 17px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
}
.main-menu .menu-action-badge {
    position: absolute;
    right: 12px;
    top: 10px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(232, 204, 130);
    color: rgb(30, 24, 16);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.main-menu .menu-join {
    flex-shrink: 0;
    margin: 2px 0 8px 0;
    padding: 6px 0 8px 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(163, 132, 75, 0.32);
    border-bottom-color: rgba(163, 132, 75, 0.32);
}
.main-menu .menu-join-title {
    margin: 0 0 6px 2px;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(200, 184, 148);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
}
.main-menu .menu-join-line { flex-direction: row; align-items: center; }
/* UI-257: Join and Observe are as wide as their one-line words in a smaller type; the code field takes the rest of the
   row, wide enough for its placeholder. */
.main-menu .menu-join-code { flex-grow: 1; flex-shrink: 1; min-width: 84px; height: 36px; margin: 0 6px 0 0; }
.main-menu .menu-join-submit { flex-grow: 0; flex-shrink: 0; width: auto; min-width: 0; height: 36px; min-height: 36px;
    padding: 0 8px; font-size: 15px; white-space: nowrap; -unity-text-align: middle-center; }
.main-menu #observe-invitation { margin-left: 6px; }
.main-menu .menu-actions-spacer { flex-grow: 1; }
.main-menu .menu-action-quiet { color: rgb(196, 184, 156); }
/* MENU-31: Sign out and Quit game side by side in the column's last row. */
.main-menu .menu-actions-footer { flex-direction: row; flex-shrink: 0; }
.main-menu .menu-actions-footer > .menu-action { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; padding: 0; -unity-text-align: middle-center; }
.main-menu .menu-actions-footer > #sign-out { margin-right: 6px; }
.main-menu .menu-status {
    flex-shrink: 0;
    width: 980px;
    max-width: 100%;
    height: 40px;
    margin-top: 6px;
    font-size: 15px;
    -unity-text-align: middle-center;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}

/* REPLAY-04: the replay library in the menu's window (and before sign-in): rows with Play, Export and Delete in
   fixed places, Import (and Back) at the foot, one status line. */
.main-menu .replay-library { flex-grow: 1; padding: 6px 8px 0 8px; }
.main-menu .replay-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.main-menu .replay-row { flex-direction: row; align-items: center; }
.main-menu .replay-row:hover { background-image: resource("Wotr/Art/UI/frontend/row"); }
.main-menu .replay-action { width: 78px; height: 34px; min-height: 34px; margin-left: 6px; flex-shrink: 0; font-size: 15px; }
.main-menu .replay-footer { flex-direction: row; justify-content: flex-end; flex-shrink: 0; height: 44px; align-items: center; }
.main-menu .replay-footer-action { width: 120px; height: 36px; min-height: 36px; margin-left: 8px; }
.main-menu .replay-status { flex-shrink: 0; height: 22px; font-size: 14px; color: rgb(214, 198, 160); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* UI-255: the gateway card is one centred column 400 px wide. Title and tagline are centred, labels stand above their
   fields, and the fields and every button share the column's edges and one size; Settings and Replays share the last
   row. Labels keep the parchment colour on hover and turn gold on focus instead of Unity's blue. */
.frontend .login-card {
    width: 480px;
    max-width: 94%;
    padding: 18px 36px 20px 36px;
    align-items: stretch;
    /* UI-470 (owner, 2026-11-03): the menus' thin card (frontend/card) instead of a flat plate with a border. */
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Wotr/Art/UI/frontend/card");
    -unity-slice-top: 24;
    -unity-slice-right: 24;
    -unity-slice-bottom: 24;
    -unity-slice-left: 24;
    -unity-slice-scale: 0.5px;
    border-width: 0;
}
.frontend .login-card .gateway-heading { justify-content: center; margin-bottom: 4px; }
.frontend .login-card .gateway-heading .title { -unity-text-align: middle-center; font-size: 21px; letter-spacing: 3px; }
.frontend .login-card .gateway-tagline {
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 16px;
    color: rgb(184, 174, 150);
    margin: 0 0 4px 0;
}
.frontend .login-card .unity-text-field {
    flex-direction: column;
    align-items: stretch;
    margin: 8px 0 0 0;
}
.frontend .login-card .unity-text-field > .unity-base-field__label {
    min-width: 0;
    width: auto;
    margin: 0 0 3px 2px;
    padding: 0;
    font-size: 15px;
    color: rgb(214, 198, 160);
}
.frontend .login-card .unity-text-field:hover > .unity-base-field__label { color: rgb(214, 198, 160); }
.frontend .login-card .unity-text-field:focus > .unity-base-field__label { color: rgb(245, 212, 133); }
.frontend .login-card .unity-text-field > .unity-base-text-field__input {
    height: 36px;
    min-height: 36px;
    margin: 0;
    font-size: 18px;
    border-radius: 2px;
}
.frontend .login-card .unity-text-field:focus > .unity-base-text-field__input {
    border-top-color: rgb(214, 178, 108);
    border-bottom-color: rgb(214, 178, 108);
    border-left-color: rgb(214, 178, 108);
    border-right-color: rgb(214, 178, 108);
}
/* UI-470: a small line icon inside each field (frontend/icon-account, icon-password); the text starts after it. */
.frontend .login-card #auth-username > .unity-base-text-field__input,
.frontend .login-card #auth-password > .unity-base-text-field__input {
    padding-left: 32px;
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position-x: left 10px;
    background-position-y: center;
}
.frontend .login-card #auth-username > .unity-base-text-field__input { background-image: resource("Wotr/Art/UI/frontend/icon-account"); }
.frontend .login-card #auth-password > .unity-base-text-field__input { background-image: resource("Wotr/Art/UI/frontend/icon-password"); }
.frontend .login-card .status-message { -unity-text-align: middle-center; margin: 6px 0 0 0; font-size: 15px; }
.frontend .login-card .auth-actions { flex-direction: column; align-items: stretch; flex-shrink: 0; margin-top: 10px; }
/* UI-470: Settings and Replays stand under a hairline with a tiny lozenge (frontend/divider) instead of a plain rule. */
.frontend .login-card .auth-secondary { flex-direction: row; flex-shrink: 0; margin-top: 8px; padding-top: 10px;
    border-top-width: 0; background-image: resource("Wotr/Art/UI/frontend/divider"); background-size: 200px 8px;
    background-repeat: no-repeat; background-position-x: center; background-position-y: top; }
.frontend .login-card .auth-actions .action,
.frontend .login-card .auth-secondary .action {
    height: 38px;
    min-height: 38px;
    margin: 0 0 6px 0;
    padding: 0 12px;
    font-size: 18px;
    flex-grow: 0;
    width: auto;
}
.frontend .login-card .auth-secondary .action { flex-grow: 1; flex-basis: 0; margin: 0; }
.frontend .login-card .auth-secondary .action:first-child { margin-right: 10px; }
/* UI-470: USS has no :first-child, so the thin buttons touched; the gap is given to Settings by name. */
.frontend .login-card .auth-secondary #open-interface { margin-right: 8px; }
.frontend .login-card .auth-hint { -unity-text-align: middle-center; font-size: 14px; margin: 0; color: rgb(170, 160, 136); }

/* LOBBY-01: Open games makes room for the lobby — compact game rows, then a fixed-height chat with a folding column of
   the players online; a right-click on a name opens a small challenge tab, and a challenge to this player shows a tab
   over the window on any page. */
.main-menu .public-room-row { height: 46px; min-height: 46px; margin-bottom: 4px; padding: 0 10px 0 8px; }
.main-menu .public-room-row .menu-row-emblem { width: 26px; height: 26px; margin-right: 10px; }
.main-menu .public-room-row .menu-row-text { height: 38px; }
.main-menu .public-room-row .menu-row-title { height: 20px; font-size: 15px; }
.main-menu .public-room-row .menu-row-detail { height: 16px; margin-top: 2px; font-size: 12px; }
.main-menu .public-room-row .public-room-action { width: 80px; height: 32px; min-height: 32px; margin-left: 6px; font-size: 14px; }

.main-menu .lobby-panel {
    flex-direction: row;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    height: 196px;
    min-height: 196px;
    margin: 8px 0 0 0;
    padding: 6px 8px 6px 10px;
    border-width: 1px;
    border-color: rgba(163, 132, 75, 0.38);
    border-radius: 2px;
    background-color: rgba(10, 9, 8, 0.5);
}
.main-menu .lobby-chat { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; }
.main-menu .lobby-chat-header { flex-direction: row; align-items: center; height: 20px; flex-shrink: 0; }
.main-menu .lobby-chat-title { font-size: 13px; letter-spacing: 1px; color: rgb(232, 204, 130);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold"); }
.main-menu .lobby-chat-hint { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-left: 10px; font-size: 11px; color: rgb(150, 144, 128); }
.main-menu .lobby-chat-log { flex-grow: 1; flex-shrink: 1; min-height: 0; margin: 4px 0; padding: 2px 4px;
    background-color: rgba(10, 9, 8, 0.55); }
.main-menu .lobby-message { flex-direction: row; flex-wrap: wrap; min-width: 0; margin-bottom: 1px; overflow: hidden; }
.main-menu .lobby-author { margin: 0 6px 0 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: rgb(214, 186, 120); }
.main-menu .lobby-author:hover { color: rgb(245, 212, 133); }
.main-menu .lobby-text { flex-shrink: 1; min-width: 0; max-width: 100%; margin: 0; padding: 0; font-size: 13px; white-space: normal; color: rgb(231, 228, 215); }
.main-menu .lobby-chat-line { flex-direction: row; align-items: center; height: 34px; flex-shrink: 0; }
.main-menu .lobby-chat-input { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 30px; margin: 0; font-size: 14px; }
.main-menu .lobby-chat-input > .unity-base-text-field__input { color: rgb(245, 239, 222); background-color: rgba(10, 9, 8, 0.72); }
.main-menu .lobby-status { height: 16px; flex-shrink: 0; min-width: 0; margin: 2px 0 0 0; font-size: 12px; color: rgb(232, 195, 145);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* LOBBY-02: unfolded, the players online lie over the chat's right side and its input, beside the strip (8 px
   padding + 16 px strip + 2 px), instead of narrowing them. */
.main-menu .lobby-online { position: absolute; top: 6px; bottom: 6px; right: 26px; width: 160px; padding: 4px 6px 4px 8px;
    border-width: 1px; border-color: rgba(163, 132, 75, 0.6); border-radius: 2px; background-color: rgb(22, 20, 18); }
.main-menu .lobby-online-title { height: 20px; font-size: 12px; letter-spacing: 1px; color: rgb(232, 204, 130);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold"); }
.main-menu .lobby-online-list { flex-grow: 1; min-height: 0; }
/* LOBBY-02: the players online fold into a grey strip at the panel's right edge; the tab at its bottom folds and
   unfolds them and keeps its place. A plain grey tab (no button frame) with "Online" written upwards. */
/* UI-470: the strip and its tab in the menus' charcoal and muted gold instead of grey. */
.main-menu .lobby-online-strip { width: 16px; flex-shrink: 0; margin-left: 6px; flex-direction: column;
    justify-content: flex-end; border-radius: 2px; background-color: rgba(163, 132, 75, 0.12); }
.main-menu .lobby-online-strip .lobby-online-tab { width: 16px; min-width: 16px; height: 64px; min-height: 64px; margin: 0;
    padding: 0; background-image: none; background-color: rgba(52, 45, 35, 0.9); border-width: 1px;
    border-color: rgba(163, 132, 75, 0.6); border-radius: 2px; }
.main-menu .lobby-online-strip .lobby-online-tab:hover { background-image: none; background-color: rgba(74, 63, 46, 0.95);
    border-color: rgba(214, 178, 108, 0.85); }
.main-menu .lobby-online-strip .lobby-online-tab.pressed { background-image: none; background-color: rgba(30, 26, 21, 0.95); }
.main-menu .lobby-online-tab-label { position: absolute; width: 56px; height: 14px; left: -20px; top: 25px; rotate: -90deg;
    margin: 0; padding: 0; font-size: 11px; letter-spacing: 1px; -unity-text-align: middle-center; white-space: nowrap;
    color: rgb(236, 228, 208); }
.main-menu .lobby-player { height: 22px; margin: 0; padding: 0 4px; font-size: 13px; color: rgb(231, 228, 215);
    -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.main-menu .lobby-player:hover { background-color: rgba(232, 204, 130, 0.12); color: rgb(245, 212, 133); }
.main-menu .lobby-player-you { color: rgb(150, 144, 128); }
.main-menu .lobby-context { position: absolute; width: 170px; padding: 6px; border-width: 1px; border-color: rgba(196, 162, 98, 0.8);
    border-radius: 2px; background-color: rgb(22, 20, 18); }
.main-menu .lobby-context-name { height: 20px; margin: 0 0 4px 2px; font-size: 13px; -unity-font-style: bold; color: rgb(245, 212, 133);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.main-menu .lobby-context-action { height: 32px; min-height: 32px; margin: 0; font-size: 14px; }
.main-menu .challenge-tab { position: absolute; left: 16px; right: 16px; top: 52px; height: 48px; flex-direction: row; align-items: center;
    padding: 0 10px 0 16px; border-width: 1px; border-color: rgb(214, 178, 108); border-radius: 2px;
    /* UI-470: a warm charcoal plate under a bright gilt line instead of the red lacquer; it still stands out. */
    background-color: rgb(44, 35, 23); }
.main-menu .challenge-text { flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 15px; -unity-font-style: bold; color: rgb(250, 232, 196);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.main-menu .challenge-action { width: 92px; height: 34px; min-height: 34px; margin: 0 0 0 8px; font-size: 14px; }

/* UI-263: the crests of a listed game's expansions: before the row's buttons, and in a saved game's upper right. */
.main-menu .menu-row > .expansion-crests { margin: 0 8px 0 4px; }
.main-menu .saved-match .expansion-crests { position: absolute; top: 8px; right: 12px; }

/* UI-263: the rules' controls, shared by the waiting room (a column of expansion checkboxes beside a column of chips)
   and the demo page (DEMO-06, .rules-row). UI-364: an expansion's checkbox is its whole cell, without a frame: the
   medallion (56 px art drawn at 44 px, the crest inside) above a caption with the strip's tick box and the module's
   word. UI-470 (owner, 2026-11-03): the medallion is the thin frontend/medallion and the ticks the small boxes of
   frontend/check; a variant chip that is on wears the menus' selected button (a warm field, a bright line), not red
   lacquer. */
.frontend .waiting-rules-modules { flex-direction: column; flex-shrink: 0; width: 60px; margin-right: 6px; }
.frontend .rules-module {
    height: 58px;
    min-height: 58px;
    min-width: 0;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
}
.frontend .rules-module:hover { background-image: none; }
.frontend .unity-button.action.rules-module.pressed { background-image: none; }
.frontend .rules-medallion {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-image: resource("Wotr/Art/UI/frontend/medallion");
}
.frontend .rules-module:hover > .rules-medallion { background-image: resource("Wotr/Art/UI/frontend/medallion-hover"); }
.frontend .rules-module.pressed > .rules-medallion { background-image: resource("Wotr/Art/UI/frontend/medallion-pressed"); }
.frontend .rules-module.module-fate.on > .rules-medallion { background-image: resource("Wotr/Art/UI/frontend/medallion-fate-on"); }
.frontend .rules-module.module-lords.on > .rules-medallion { background-image: resource("Wotr/Art/UI/frontend/medallion-lords-on"); }
.frontend .rules-module.module-kings.on > .rules-medallion { background-image: resource("Wotr/Art/UI/frontend/medallion-kings-on"); }
/* Greyed out while it cannot change (the guest, a ready host, a started game): the art and the word dim; a ticked box
   stays readable. */
.frontend .rules-module:disabled { opacity: 0.45; }
.frontend .rules-module.on:disabled { opacity: 0.75; }
.frontend .rules-module:disabled > .rules-medallion { -unity-background-image-tint-color: rgb(150, 150, 150); }
.frontend .rules-module:disabled .rules-module-name { color: rgb(158, 150, 128); }
.frontend .rules-medallion-crest { width: 28px; height: 28px; }
/* An expansion that is not in the game shows its crest in grey. */
.frontend .rules-medallion .expansion-crest { -unity-background-image-tint-color: rgb(120, 116, 108); }
.frontend .rules-module.on .expansion-crest { -unity-background-image-tint-color: rgb(255, 255, 255); }
.frontend .rules-module.on:disabled .expansion-crest { -unity-background-image-tint-color: rgb(170, 170, 170); }
.frontend .rules-module-caption { flex-direction: row; align-items: center; justify-content: center; height: 13px; margin-top: 1px; }
.frontend .rules-module-caption > .rules-check { width: 12px; height: 12px; margin-right: 3px; }
.frontend .rules-module.on .rules-check { background-image: resource("Wotr/Art/UI/frontend/check-selected"); }
.frontend .rules-module-name {
    height: 13px;
    font-size: 11px;
    letter-spacing: 1px;
    color: rgb(214, 198, 160);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
    -unity-text-align: middle-center;
}
.frontend .waiting-rules-variants { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: column; }
.frontend .rules-chip {
    flex-direction: row;
    align-items: center;
    height: 25px;
    min-height: 25px;
    min-width: 0;
    margin: 0 0 4px 0;
    padding: 0 6px 0 7px;
}
.frontend .rules-check {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-right: 5px;
    background-image: resource("Wotr/Art/UI/frontend/check");
}
.frontend .rules-chip.on .rules-check { background-image: resource("Wotr/Art/UI/frontend/check-selected"); }
.frontend .rules-chip-name {
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

/* DEMO-06: on the demo page the medallions stand in a row and the chips in two rows of three beside them. */
.frontend .waiting-rules.rules-row { flex-direction: row; align-items: flex-start; flex-shrink: 0; height: 62px; margin: 0 0 8px 0; }
.frontend .rules-row .waiting-rules-modules { flex-direction: row; width: auto; margin-right: 10px; }
.frontend .rules-row .rules-module { width: 60px; }
.frontend .rules-row .waiting-rules-variants { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.frontend .rules-row .rules-chip { width: 32%; margin: 0 1% 4px 0; }
.frontend .rules-row .rules-chip-name { font-size: 11px; }

/* UI-415 (owner): a compact menu before the game. Smaller buttons (32 points, the project's click target) and almost no
   empty space between frames, header plates, tabs and rows, so every screen shows more of what it already lists; every
   control keeps its place. The masthead gives its height to the window, and the action column ends under its last row
   instead of stretching an empty frame. Covers the sign-in card, the main menu's pages, the waiting room
   (WaitingRoom.uss) and Settings (Wotr.uss). */
.main-menu .menu-page { padding: 6px 12px 18px 12px; }
.main-menu .menu-masthead { margin-bottom: 2px; }
.main-menu .menu-title { font-size: 30px; letter-spacing: 6px; margin: 0; padding: 0; }
.main-menu .menu-player { font-size: 13px; margin: 0; padding: 0; }
.main-menu .menu-body { height: 600px; }
.main-menu .menu-window { margin-right: 8px; padding: 8px 12px 12px 12px; }
.main-menu .menu-window-header { height: 32px; margin-bottom: 4px; }
.main-menu .menu-window-title { font-size: 16px; }
.main-menu .menu-empty,
.main-menu #public-games-empty { margin: 6px 6px; font-size: 15px; }
/* Text fields: a line of type with a little air, not 8 points of padding round it. */
.main-menu .unity-base-text-field__input { padding: 2px 8px; font-size: 15px; }

/* Rows: 46 points instead of 60, 3 between them. */
.main-menu .menu-row { height: 46px; min-height: 46px; margin: 0 4px 3px 0; padding: 0 12px 0 8px; }
.main-menu .menu-row-emblem { width: 28px; height: 28px; margin-right: 8px; }
.main-menu .menu-row-text { height: 38px; }
.main-menu .menu-row-title { height: 20px; font-size: 15px; }
.main-menu .menu-row-detail { height: 16px; margin-top: 1px; font-size: 13px; }
.main-menu .menu-row-action { margin-left: 8px; font-size: 14px; }
.main-menu .public-room-row { height: 40px; min-height: 40px; margin-bottom: 3px; }
.main-menu .public-room-row .menu-row-emblem { width: 24px; height: 24px; margin-right: 8px; }
.main-menu .public-room-row .menu-row-text { height: 34px; }
.main-menu .public-room-row .menu-row-title { height: 18px; font-size: 14px; }
.main-menu .public-room-row .public-room-action { width: 76px; height: 32px; min-height: 32px; font-size: 13px; }
.main-menu .saved-match { min-height: 0; margin: 0 4px 3px 0; }
.main-menu .saved-match .resume-match { padding: 4px 12px; }
.main-menu .saved-match-heading { margin: 0; padding: 0; font-size: 15px; }
.main-menu .saved-match-detail { margin: 0; padding: 0; font-size: 13px; }
.main-menu .lobby-panel { margin-top: 4px; padding: 4px 6px 4px 8px; }

/* The test scenarios: Back beside the hint (the window's header already names the page), lower tabs, field and rows. */
.main-menu .menu-window > .frontend-form { padding: 2px 2px 0 2px; }
.main-menu .menu-window > .frontend-form .row { margin-top: 0; }
.frontend .test-scenario-header { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 0 4px 0; }
.frontend .test-scenario-header > .test-scenario-hint { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0 0 0 6px; padding: 0; font-size: 13px; }
.frontend .test-scenario-tabs,
.frontend .menu-tabs { margin: 0 0 4px 0; }
.frontend .test-scenario-tab,
.frontend .menu-tab { height: 32px; min-height: 32px; margin-right: 4px; font-size: 14px; }
.frontend .test-scenario-search-row { margin: 0 0 4px 0; }
.frontend .test-scenario-list .test-scenario-search { height: 30px; min-height: 30px; margin: 0 4px 0 0; }
.frontend .test-scenario-list .test-scenario-search > .unity-base-text-field__input { height: 30px; min-height: 30px; margin: 0; }
/* UI-470 (owner, 2026-11-03): a small lens inside the search field (frontend/icon-search); the text starts after it. */
.frontend .test-scenario-list .test-scenario-search > .unity-base-text-field__input {
    padding-left: 30px;
    background-image: resource("Wotr/Art/UI/frontend/icon-search");
    background-size: 16px 16px;
    background-repeat: no-repeat;
    background-position-x: left 9px;
    background-position-y: center;
}
.frontend .test-scenario-group { margin: 6px 0 2px 0; font-size: 13px; }
.frontend .test-scenario { min-height: 0; margin: 0 2px 3px 0; padding: 5px 10px; }
.frontend .test-scenario-title { margin: 0; padding: 0; font-size: 15px; }
.frontend .test-scenario-description { margin: 1px 0 0 0; padding: 0; font-size: 13px; }

/* Host a game, Demo and Replays: the same controls, lower and closer. */
.main-menu .host-form { padding: 2px 4px 0 4px; }
.main-menu .host-field { height: 34px; margin-bottom: 6px; }
.main-menu #room-name.host-control { height: 32px; }
.main-menu .host-segments > .host-segment { height: 32px; min-height: 32px; font-size: 15px; }
.main-menu .host-footer { height: 36px; }
.main-menu .host-footer > .host-back,
.main-menu .host-footer > .host-submit { height: 32px; min-height: 32px; font-size: 15px; }
.main-menu .side-choice { height: 96px; margin-bottom: 8px; }
.main-menu .side-choice > .side-card { padding: 8px 12px; }
.main-menu .demo-note { margin-bottom: 6px; font-size: 14px; }
/* UI-497: Find game. Two columns, no scrolling: the rows on the left, the side cards and the rating on the right. */
.main-menu .find-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.main-menu .find-column { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 16px; }
.main-menu .find-column:last-child { margin-right: 0; }
.main-menu .find-column > .host-heading { flex-shrink: 0; margin-bottom: 2px; }
.main-menu .find-row { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 0; min-height: 34px; max-height: 44px; }
.main-menu .find-row-label { width: 84px; flex-shrink: 0; justify-content: center; }
.main-menu .find-row-name {
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: rgb(226, 214, 184);
    -unity-text-align: middle-left;
}
.main-menu .find-row-detail {
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: rgb(190, 178, 150);
    -unity-text-align: middle-left;
}
.main-menu .find-segments { flex-grow: 1; flex-shrink: 0; justify-content: flex-end; }
.main-menu .find-segments > .host-segment { width: 66px; height: 30px; min-height: 30px; margin: 0 0 0 4px; padding: 0; font-size: 14px; }
.main-menu .find-form .side-choice { height: 112px; margin: 0 -4px 6px -4px; }
.main-menu .find-form .side-choice > .side-card { padding: 8px 10px; }
.main-menu .find-form .side-card-heading .menu-row-emblem { width: 28px; height: 28px; }
.main-menu .find-form .side-card-name { font-size: 14px; letter-spacing: 0; }
.main-menu .find-form .side-card-detail { font-size: 13px; }
.main-menu .find-form .find-note {
    flex-shrink: 0;
    margin: 8px 0 0 0;
    padding: 0;
    font-size: 14px;
    white-space: normal;
    color: rgb(206, 194, 164);
}
.main-menu .find-form .find-rating {
    flex-shrink: 0;
    height: 32px;
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 15px;
    color: rgb(226, 214, 184);
    -unity-text-align: middle-left;
}
.main-menu .host-footer > .find-submit { width: 200px; }
/* UI-503: every row shares the window's height, so all 25 stand without scrolling; a shorter list keeps their size. */
.main-menu .leaderboard { flex-grow: 1; flex-shrink: 1; min-height: 0; padding: 0 4px; }
.main-menu .leaderboard-head {
    flex-direction: row;
    flex-shrink: 0;
    height: 22px;
    border-bottom-width: 1px;
    border-color: rgb(120, 104, 70);
}
.main-menu .leaderboard-head > .leaderboard-cell {
    font-size: 13px;
    color: rgb(214, 198, 160);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
}
.main-menu .leaderboard-rows { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.main-menu .leaderboard-row { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; max-height: 26px; }
.main-menu .leaderboard-row.leaderboard-own { background-color: rgba(176, 148, 88, 0.3); }
.main-menu .leaderboard-cell {
    margin: 0;
    padding: 0 4px;
    font-size: 13px;
    color: rgb(226, 214, 184);
    white-space: nowrap;
    -unity-text-align: middle-left;
}
.main-menu .leaderboard-rank { width: 36px; flex-shrink: 0; -unity-text-align: middle-right; }
.main-menu .leaderboard-name { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.main-menu .leaderboard-number { width: 62px; flex-shrink: 0; -unity-text-align: middle-right; }
.main-menu .leaderboard-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0 24px;
    font-size: 15px;
    white-space: normal;
    color: rgb(214, 198, 160);
    -unity-text-align: middle-center;
}
.main-menu .leaderboard-footer { flex-direction: row; align-items: center; flex-shrink: 0; height: 26px; margin-top: 2px; }
.main-menu .leaderboard-you { flex-shrink: 0; margin: 0; padding: 0 4px; font-size: 14px; color: rgb(240, 226, 190); }
.main-menu .leaderboard-status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 13px;
    color: rgb(236, 160, 140);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-right;
}
/* UI-498: art and opacity only here, never a filter: it crashes the renderer when a parent fades. */
.main-menu .host-footer > .find-progress {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 12px;
}
.main-menu .find-indicator { width: 24px; height: 24px; flex-shrink: 0; margin: 0 8px 0 0; }
.main-menu .find-elapsed {
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: rgb(226, 214, 184);
    -unity-text-align: middle-right;
}
.main-menu .find-opponent { flex-grow: 1; flex-shrink: 1; min-height: 0; align-items: center; justify-content: center; }
.main-menu .find-opponent-heading { flex-shrink: 0; }
.main-menu .find-opponent-name {
    flex-shrink: 0;
    margin: 4px 0;
    padding: 0;
    font-size: 26px;
    color: rgb(240, 226, 190);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
    -unity-text-align: middle-center;
}
.main-menu .find-opponent-rating {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 16px;
    color: rgb(214, 198, 160);
    -unity-text-align: middle-center;
}
.main-menu .replay-library { padding: 2px 4px 0 4px; }
.main-menu .replay-action { height: 32px; min-height: 32px; font-size: 14px; }
.main-menu .replay-footer { height: 36px; }
.main-menu .replay-footer-action { height: 32px; min-height: 32px; }

/* The action column: 32-point rows 3 apart; Join by code tighter; Sign out and Quit game follow Settings. */
.main-menu .menu-actions { align-self: flex-start; padding: 12px; }
.main-menu .menu-action { height: 32px; min-height: 32px; margin-bottom: 3px; padding-left: 14px; font-size: 15px; }
.main-menu .menu-action-badge { top: 6px; width: 20px; height: 20px; border-radius: 10px; font-size: 12px; }
.main-menu .menu-join { margin: 1px 0 4px 0; padding: 4px 0 5px 0; }
.main-menu .menu-join-title { margin: 0 0 3px 2px; font-size: 12px; }
.main-menu .menu-join-code { height: 32px; }
.main-menu .menu-join-submit { height: 32px; min-height: 32px; font-size: 14px; }
.main-menu .menu-actions-spacer { flex-grow: 0; height: 6px; }
.main-menu .menu-status { height: 24px; margin-top: 2px; font-size: 14px; }

/* The sign-in card: the same column, closer. */
/* The bottom padding keeps room for an update note under Settings (DIST-17). */
/* UI-470: one point more than UI-415 gave, for the 1-point border the card's art replaced; the content keeps its size. */
.frontend .login-card { padding: 13px 29px 19px 29px; }
.frontend .login-card .gateway-heading { margin-bottom: 0; }
.frontend .login-card .gateway-tagline { margin: 0 0 2px 0; font-size: 14px; }
.frontend .login-card .unity-text-field { margin: 4px 0 0 0; }
.frontend .login-card .unity-text-field > .unity-base-field__label { margin: 0 0 2px 2px; font-size: 14px; }
.frontend .login-card .unity-text-field > .unity-base-text-field__input { height: 32px; min-height: 32px; padding: 2px 8px; font-size: 16px; }
.frontend .login-card .status-message { margin: 4px 0 0 0; font-size: 14px; }
.frontend .login-card .auth-actions { margin-top: 8px; }
.frontend .login-card .auth-actions .action,
.frontend .login-card .auth-secondary .action { height: 32px; min-height: 32px; margin: 0 0 4px 0; font-size: 16px; }
/* UI-470: room for the 8-point divider over Settings and Replays in the same 11 points as before. */
.frontend .login-card .auth-secondary { margin-top: 2px; padding-top: 9px; }
.frontend .login-card .auth-secondary .action { margin: 0; }
.frontend .login-card .auth-hint { font-size: 13px; }
