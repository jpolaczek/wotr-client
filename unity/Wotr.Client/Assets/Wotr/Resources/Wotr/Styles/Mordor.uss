/* UI-154: the Mordor track on the map (Runtime/Map/Mordor/MapMordorTrack.cs, FELLOWSHIP_UX F07a). Stones and gates
   are art of graphicalassets/ui/src/mordor; step numbers are ink text shown only zoomed in. */
.map .mordor-track-inactive { opacity: 0.9; }
.map .mordor-slab,
.map .mordor-crack,
.map .mordor-gate {
    position: absolute;
    margin: 0;
    padding: 0;
    min-width: 0;
    min-height: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}
.map .mordor-slab:hover,
.map .mordor-crack:hover,
.map .mordor-gate:hover,
.map .mordor-slab:active,
.map .mordor-crack:active,
.map .mordor-gate:active { background-color: rgba(0, 0, 0, 0); }
.map .mordor-slab { background-image: resource("Wotr/Art/UI/mordor/slab"); }
.map .mordor-slab.mordor-passed { background-image: resource("Wotr/Art/UI/mordor/slab-passed"); }
.map .mordor-slab.mordor-next { background-image: resource("Wotr/Art/UI/mordor/slab-next"); }
.map .mordor-crack { background-image: resource("Wotr/Art/UI/mordor/crack-of-doom"); }
.map .mordor-crack.mordor-next { background-image: resource("Wotr/Art/UI/mordor/crack-of-doom-next"); }
.map .mordor-gate { background-image: resource("Wotr/Art/UI/mordor/gate"); }
.map .mordor-gate.mordor-next { background-image: resource("Wotr/Art/UI/mordor/gate-next"); }
.map #mordor-step-number {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 5px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(58, 57, 52);
}
.map .mordor-passed > #mordor-step-number { color: rgba(58, 57, 52, 0.55); }
.map .mordor-track-detail #mordor-step-number { display: flex; }

/* The Fellowship on the track: its Corruption and the missing-attempt mark at its right. */
.map #fellowship-mordor-status {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 16px;
    padding: 0 3px;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(58, 57, 52);
    background-color: rgba(239, 228, 198, 0.9);
}
.map #fellowship-mordor-ring {
    width: 11px;
    height: 11px;
    margin-right: 2px;
    background-image: resource("Wotr/Art/UI/icons/ring");
    -unity-background-scale-mode: scale-to-fit;
}
.map #fellowship-mordor-corruption {
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(58, 57, 52);
}
.map #fellowship-mordor-idle {
    width: 12px;
    height: 12px;
    margin-left: 3px;
    background-image: resource("Wotr/Art/UI/characters/waiting");
    -unity-background-scale-mode: scale-to-fit;
}

/* UI-155: offered stones answer the pointer; the Shadow sees the stones swell once when the Fellowship enters,
   and a revealed Fellowship that may hide glows in the legal green. */
.map .mordor-slab,
.map .mordor-crack,
.map .mordor-gate {
    transition-property: scale;
    transition-duration: 0.35s;
}
.map .mordor-next:hover { scale: 1.1 1.1; }
.map .mordor-track-pulse .mordor-slab,
.map .mordor-track-pulse .mordor-crack,
.map .mordor-track-pulse .mordor-gate { scale: 1.3 1.3; }
.map .fellowship-marker.fellowship-hide-target {
    border-width: 2px;
    border-color: rgb(144, 203, 172);
}
/* UI-236: the figure that declares its position glows like the other legal targets on the map. */
.map .fellowship-marker.fellowship-declare-target {
    border-width: 2px;
    border-color: rgb(144, 203, 172);
    border-radius: 8px;
}
.map .fellowship-marker.fellowship-declare-target:hover { scale: 1.08 1.08; }


/* UI-231: in the Fellowship panel the Mordor track is its own thing: a dark basalt band with an ember rim, on which
   the six steps are round stones joined by a line of embers; the current stone burns, the passed ones have cooled and
   the last holds the Crack of Doom. Unlike the square cells of the progress and corruption tracks, it never lines
   up with the corruption row below. Sizes stay those of the row (42 px; 32 px dropped down; 25 px compact). */
#board-screen .fellowship-panel .mordor-track .fellowship-track-lane {
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 19px;
    border-color: rgb(158, 70, 38);
    background-color: rgb(26, 16, 13);
}
#board-screen .fellowship-panel .mordor-track .mordor-track-path {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background-color: rgba(214, 96, 44, 0.75);
}
#board-screen .fellowship-panel .mordor-track .fellowship-track-cell {
    flex-grow: 0;
    flex-basis: auto;
    width: 26px;
    min-width: 26px;
    height: 26px;
    margin: 0;
    border-width: 2px;
    border-radius: 13px;
    border-color: rgb(126, 58, 36);
    background-color: rgb(48, 27, 20);
}
#board-screen .fellowship-panel .mordor-track .fellowship-track-cell.track-passed {
    border-color: rgb(78, 52, 44);
    background-color: rgb(34, 28, 26);
}
#board-screen .fellowship-panel .mordor-track .fellowship-track-cell.selected {
    border-color: rgb(255, 156, 74);
    background-color: rgb(116, 46, 22);
}
/* The stones carry no numbers; the row's value and tooltip give the step. */
#board-screen .fellowship-panel .mordor-track .fellowship-track-tick { display: none; }
#board-screen .fellowship-panel .mordor-track .fellowship-track-end { left: 5px; bottom: 5px; width: 12px; height: 12px; }
#board-screen .fellowship-panel .mordor-track .fellowship-track-marker { top: 7px; height: 24px; }
#board-screen .fellowship-panel .mordor-track .fellowship-track-value { color: rgb(255, 156, 74); }
#board-screen .board-dropdowns .fellowship-panel .mordor-track .fellowship-track-lane { height: 32px; border-radius: 16px; }
#board-screen .board-dropdowns .fellowship-panel .mordor-track .fellowship-track-marker { top: 5px; height: 22px; }
#board-screen.compact-edge-board .board-dropdowns .fellowship-panel .mordor-track .fellowship-track-lane { height: 25px; border-radius: 12px; }
#board-screen.compact-edge-board .board-dropdowns .fellowship-panel .mordor-track .fellowship-track-cell {
    width: 21px;
    min-width: 21px;
    height: 21px;
    border-radius: 10px;
}
#board-screen.compact-edge-board .board-dropdowns .fellowship-panel .mordor-track .fellowship-track-marker { top: 2px; height: 20px; }
