/* UI-169: the end of the game — a full overlay that darkens the board, with a window in the frame of the battle
   window (frames/panel): the scene of the reason (end/scene-*), the winner's emblem beside the title plate
   (end/title-victory or end/title-defeat from the player's view), who won and why, four lines of the game and three
   buttons in fixed places. 9-slice values are texture pixels (2× points). */
#board-screen .game-end {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 9, 9, 0.72);
}
#board-screen .game-end-window {
    width: 520px;
    max-width: 94%;
    padding: 12px 18px 16px 18px;
    align-items: center;
    background-image: resource("Wotr/Art/UI/frames/panel");
    -unity-slice-top: 44;
    -unity-slice-right: 44;
    -unity-slice-bottom: 44;
    -unity-slice-left: 44;
    -unity-slice-scale: 0.5px;
}
#board-screen .game-end-scene {
    width: 480px;
    height: 120px;
    max-width: 100%;
    flex-shrink: 0;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
}
#board-screen .game-end-scene-ring-destroyed { background-image: resource("Wotr/Art/UI/end/scene-ring-destroyed"); }
#board-screen .game-end-scene-ring-corrupted { background-image: resource("Wotr/Art/UI/end/scene-ring-corrupted"); }
#board-screen .game-end-scene-military-free { background-image: resource("Wotr/Art/UI/end/scene-military-free"); }
#board-screen .game-end-scene-military-shadow { background-image: resource("Wotr/Art/UI/end/scene-military-shadow"); }
#board-screen .game-end-heading { flex-direction: row; align-items: center; justify-content: center; height: 60px; flex-shrink: 0; }
#board-screen .game-end-emblem { width: 40px; height: 40px; margin-right: 10px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
#board-screen .game-end-emblem.side-free { background-image: resource("Wotr/Art/UI/icons/ring"); }
#board-screen .game-end-emblem.side-shadow { background-image: resource("Wotr/Art/UI/dice/faces/eye"); }
#board-screen .game-end-title-plate {
    width: 300px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-image: resource("Wotr/Art/UI/end/title-victory");
}
#board-screen .game-end.lost .game-end-title-plate { background-image: resource("Wotr/Art/UI/end/title-defeat"); }
#board-screen .game-end-title {
    margin: 0;
    padding: 0;
    font-size: 28px;
    letter-spacing: 6px;
    color: rgb(250, 232, 180);
    -unity-font-definition: resource("Wotr/Fonts/Cinzel-SemiBold");
    -unity-text-align: middle-center;
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.9);
}
#board-screen .game-end.lost .game-end-title { color: rgb(226, 206, 196); }
#board-screen .game-end-subtitle {
    margin: 6px 0 8px 0;
    font-size: 17px;
    color: rgb(241, 223, 166);
    -unity-text-align: middle-center;
    white-space: normal;
}
#board-screen .game-end-summary { width: 440px; max-width: 100%; margin-bottom: 12px; flex-shrink: 0; }
#board-screen .game-end-line {
    margin: 1px 0;
    padding: 0;
    font-size: 14px;
    color: rgb(214, 208, 184);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
#board-screen .game-end-buttons { flex-direction: row; justify-content: center; flex-shrink: 0; }
#board-screen .game-end-button { width: 136px; height: 38px; min-height: 38px; margin: 0 5px; font-size: 15px; }

/* REPLAY-04: what Save replay did, under the buttons. */
#board-screen .game-end-replay-status {
    flex-shrink: 0;
    height: 20px;
    margin-top: 6px;
    font-size: 14px;
    color: rgb(214, 198, 160);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
