/* UI-114: every clickable control presses in while the pointer (or Enter/Space) is held on it and acts only
   when the button is released inside it (docs/ui/BATTLE_WINDOW_UX.md). PressFeedback marks the held control
   with .pressed; these rules draw it. Imported last by Wotr.uss, so equal-specificity rules here win. */

.motion-enabled .unity-button,
.motion-enabled .pressable {
    transition-property: background-color, translate, -unity-background-image-tint-color;
    transition-duration: 70ms;
    transition-timing-function: ease-out;
}
.reduced-motion .unity-button,
.reduced-motion .pressable {
    transition-duration: 0s;
    transition-delay: 0s;
}

/* The held control sinks by a point; image-framed controls also darken. */
.unity-button.pressed,
.pressable.pressed { translate: 0 1px; -unity-background-image-tint-color: rgb(206, 196, 172); }
/* UI-138: framed text and icon buttons press with their pressed art; the flat colour of old buttons is gone. */
.unity-button.action.pressed { background-color: rgba(0, 0, 0, 0); }
#board-screen .unity-button.action.icon-button.pressed,
.unity-button.action.icon-button.pressed {
    background-image: resource("Wotr/Art/UI/frames/button-square-pressed");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Framed art has a pressed rendering of its own (graphicalassets/ui/assets.json variants). */
.board-left-tabs .edge-tab.pressed,
.board-left-tabs .edge-tab.pressed:hover { background-image: resource("Wotr/Art/UI/rail/edge-tab-pressed"); -unity-background-image-tint-color: rgb(255, 255, 255); }
#board-screen #open-board-menu.pressed { background-color: rgba(0, 0, 0, 0); background-image: resource("Wotr/Art/UI/frames/button-pressed"); -unity-background-image-tint-color: rgb(255, 255, 255); }
.dice-panel .die.die-free.pressed { background-image: resource("Wotr/Art/UI/dice/medallion-free-pressed"); -unity-background-image-tint-color: rgb(255, 255, 255); }
.dice-panel .die.die-shadow.pressed { background-image: resource("Wotr/Art/UI/dice/medallion-shadow-pressed"); -unity-background-image-tint-color: rgb(255, 255, 255); }
#opponent-dice .die.pressed { background-color: rgba(0, 0, 0, 0); background-image: resource("Wotr/Art/UI/dice/medallion-pressed"); -unity-background-image-tint-color: rgb(255, 255, 255); }

/* A hand card keeps its slot in place; every effect belongs to the parchment face (UI-93). */
.hand-card.pressed { translate: 0 0; -unity-background-image-tint-color: rgb(255, 255, 255); }
.hand-card.pressed > #hand-card-face { translate: 0 1px; -unity-background-image-tint-color: rgb(214, 204, 180); }
.motion-enabled .hand-card > #hand-card-face {
    transition-property: height, width, left, translate, -unity-background-image-tint-color;
    transition-duration: 140ms, 140ms, 140ms, 70ms, 70ms;
}

/* UI-224: the edge glow of enterable and attackable regions pulses gently; with Reduced motion it stays at full
   strength (the dim state applies only under .motion-enabled). */
.map-target-glow { opacity: 1; }
.motion-enabled .map-target-glow {
    transition-property: opacity;
    transition-duration: 750ms;
    transition-timing-function: ease-in-out-sine;
}
.motion-enabled .map-target-glow.map-target-glow-dim { opacity: 0.35; }

/* UI-229/UI-238/UI-240: ChoiceGlow. An object the player is asked to click for a choice (the next Guide, the die an
   Elven Ring changes, a character's change into another version) wears a thick gold rim on a warm plate; its host
   pulses it in the shared 750 ms rhythm under .motion-enabled, and Reduced motion keeps it bright and still. */
#board-screen .action.choice-glow,
#board-screen .dice-panel .die.choice-glow,
#board-screen .fellowship-panel .companion-token.choice-glow,
#board-screen .edge-left-panel .character-roster-grid .action.choice-glow {
    border-width: 3px;
    border-color: rgb(255, 214, 112);
    background-color: rgba(120, 88, 24, 0.55);
}
.motion-enabled #board-screen .choice-glow {
    transition-property: border-color, background-color, scale;
    transition-duration: 750ms;
    transition-timing-function: ease-in-out-sine;
}
.motion-enabled #board-screen .choice-glow-pulse .action.choice-glow,
.motion-enabled #board-screen .choice-glow-pulse .die.choice-glow,
.motion-enabled #board-screen .choice-glow-pulse .companion-token.choice-glow,
.motion-enabled #board-screen .choice-glow-pulse .character-roster-grid .action.choice-glow {
    border-color: rgba(255, 214, 112, 0.4);
    background-color: rgba(70, 52, 18, 0.3);
    scale: 1.05 1.05;
}

/* UI-243: the Characters row whose entry waits for a region stays chosen: solid gold, no pulse, and its second line
   reads "Choose a highlighted region". */
#board-screen .edge-left-panel .character-roster-grid .action.entry-chosen {
    border-width: 3px;
    border-color: rgb(255, 214, 112);
    background-color: rgba(150, 110, 30, 0.75);
}
#board-screen .edge-left-panel .character-roster-grid .entry-chosen-hint { color: rgb(255, 226, 150); -unity-font-style: bold; }

/* CHAT-01: the board's chat. The icon stands beside the map legend at the bottom left; the panel unrolls just above it
   over the map's western sea (260 × 176), so it covers as little of the board as it can. "?" marks unread messages. */
#board-screen .game-chat-icon {
    position: absolute;
    left: 52px;
    bottom: 12px;
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
}
#board-screen .game-chat-unread {
    position: absolute;
    right: -6px;
    top: -6px;
    width: 16px;
    height: 16px;
    margin: 0;
    padding: 0;
    border-radius: 8px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(40, 28, 12);
    background-color: rgb(255, 214, 112);
}
#board-screen .game-chat {
    position: absolute;
    left: 52px;
    bottom: 50px;
    width: 260px;
    height: 176px;
    padding: 6px;
    border-width: 1px;
    border-radius: 6px;
    border-color: rgba(214, 178, 98, 0.7);
    background-color: rgba(22, 19, 15, 0.9);
}
#board-screen .game-chat .room-chat { flex-grow: 1; flex-shrink: 1; min-height: 0; margin: 0; padding: 0; }
#board-screen .game-chat .room-chat-title { display: none; }
#board-screen .game-chat .room-chat-log {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 3px 6px;
    background-color: rgba(15, 13, 12, 0.55);
}
#board-screen .game-chat .room-chat-message { flex-direction: row; flex-wrap: wrap; margin-bottom: 1px; }
#board-screen .game-chat .room-chat-author { margin: 0 4px 0 0; padding: 0; font-size: 12px; -unity-font-style: bold; }
#board-screen .game-chat .room-chat-author.side-free { color: rgb(160, 200, 230); }
#board-screen .game-chat .room-chat-author.side-shadow { color: rgb(230, 150, 130); }
#board-screen .game-chat .room-chat-author.observer { color: rgb(200, 192, 170); }
#board-screen .game-chat .room-chat-text { flex-shrink: 1; margin: 0; padding: 0; font-size: 12px; white-space: normal; color: rgb(231, 228, 215); }
#board-screen .game-chat .room-chat-line { flex-direction: row; align-items: center; flex-shrink: 0; height: 30px; margin-top: 4px; }
#board-screen .game-chat .room-chat-input { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 26px; margin: 0 4px 0 0; font-size: 12px; }
#board-screen .game-chat .room-chat-send { width: 56px; height: 26px; min-height: 26px; flex-shrink: 0; font-size: 12px; }
#board-screen .game-chat-status { height: 14px; margin: 2px 0 0 0; font-size: 11px; color: rgb(232, 160, 120); }

/* UI-245: a combat card's targets in the Battle window — a die, a portrait or a figure stack — wear ChoiceGlow; the
   chosen one keeps a solid gold rim until the choice is sent. */
#board-screen .battle-force .portrait-medallion.choice-glow,
#board-screen .battle-force .battle-figure.choice-glow {
    border-width: 3px;
    border-radius: 18px;
    border-color: rgb(255, 214, 112);
    background-color: rgba(120, 88, 24, 0.55);
}
.motion-enabled #board-screen .choice-glow-pulse .portrait-medallion.choice-glow,
.motion-enabled #board-screen .choice-glow-pulse .battle-figure.choice-glow {
    border-color: rgba(255, 214, 112, 0.4);
    background-color: rgba(70, 52, 18, 0.3);
    scale: 1.05 1.05;
}
#board-screen .battle-force .portrait-medallion.selected,
#board-screen .battle-force .battle-figure.selected {
    border-width: 3px;
    border-radius: 18px;
    border-color: rgb(255, 226, 150);
    background-color: rgba(150, 110, 30, 0.75);
}

/* UI-246: Leadership points on their Nazgûl and Heroic Death's cancelled hits on the incoming hits — fixed gilt pips
   that glow while they can be chosen and fill once chosen. */
#board-screen .battle-leadership-points {
    position: absolute;
    left: -4px;
    right: -4px;
    top: -5px;
    flex-direction: row;
    justify-content: center;
}
#board-screen .battle-hit-cancels { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 4px; }
#board-screen .battle-choice-pip {
    width: 14px;
    height: 14px;
    min-height: 14px;
    margin: 0 1px;
    padding: 0;
    border-width: 1px;
    border-radius: 7px;
    border-color: rgb(196, 160, 90);
    background-color: rgba(30, 24, 16, 0.92);
    color: rgb(230, 200, 130);
    font-size: 9px;
    -unity-text-align: middle-center;
}
#board-screen .battle-choice-pip:disabled { opacity: 0.45; }
#board-screen .battle-choice-pip.choice-glow {
    border-width: 2px;
    border-color: rgb(255, 214, 112);
    background-color: rgba(120, 88, 24, 0.9);
}
.motion-enabled #board-screen .choice-glow-pulse .battle-choice-pip.choice-glow {
    border-color: rgba(255, 214, 112, 0.45);
    scale: 1.15 1.15;
}
#board-screen .battle-choice-pip.selected {
    border-color: rgb(255, 236, 170);
    background-color: rgb(214, 170, 70);
    color: rgb(30, 20, 10);
}
#board-screen.short-viewport .battle-choice-pip { width: 11px; height: 11px; min-height: 11px; border-radius: 6px; font-size: 7px; }
