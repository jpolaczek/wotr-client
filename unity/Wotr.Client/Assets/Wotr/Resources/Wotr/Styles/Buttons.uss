/* UI-138: icon buttons. A square gilt frame (frames/button-square, slices 8 points) holds an action icon
   (graphicalassets/ui/src/actions); the tooltip says what the symbol does. Context rules may resize them. */
.action.icon-button {
    width: 28px;
    height: 28px;
    min-width: 24px;
    min-height: 22px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Wotr/Art/UI/frames/button-square");
    -unity-slice-top: 16;
    -unity-slice-right: 16;
    -unity-slice-bottom: 16;
    -unity-slice-left: 16;
    -unity-slice-scale: 0.5px;
    border-width: 0;
}
.action.icon-button:hover, .action.icon-button:focus { background-image: resource("Wotr/Art/UI/frames/button-square-hover"); }
.action.icon-button.selected { background-image: resource("Wotr/Art/UI/frames/button-square-hover"); }
.action.icon-button:disabled { opacity: 0.45; }
.icon-button > .icon-glyph {
    width: 72%;
    height: 72%;
    max-width: 22px;
    max-height: 22px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
