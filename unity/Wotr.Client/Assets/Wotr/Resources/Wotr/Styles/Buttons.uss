/* UI-138: icon buttons. The shared thin frame (UI-471: the .action tokens of GameChrome.uss) holds an action icon
   (graphicalassets/ui/src/actions); the tooltip says what the symbol does. Context rules may resize them. */
.action.icon-button {
    width: 28px;
    height: 28px;
    min-width: 24px;
    min-height: 22px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
/* An icon has no words to brighten: keyboard focus lightens its line as hover does. A chosen one keeps its warm field. */
.action.icon-button:hover, .action.icon-button:focus { background-image: var(--game-button-hover); }
.action.icon-button.selected,
.action.icon-button.selected:hover,
.action.icon-button.selected:focus { background-image: var(--game-button-selected); }
.action.icon-button:disabled { opacity: 0.45; -unity-background-image-tint-color: rgb(255, 255, 255); }
.icon-button > .icon-glyph {
    width: 72%;
    height: 72%;
    max-width: 22px;
    max-height: 22px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
