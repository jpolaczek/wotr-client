/* The required-update window keeps the quit window's look; three actions in fixed places. */
.update-window {
    width: 560px;
}
.update-window .update-status {
    white-space: normal;
    margin: 0 0 16px 0;
    font-size: 16px;
    color: rgb(240, 206, 128);
}
.update-window .quit-actions .action {
    width: auto;
    min-width: 128px;
    padding: 0 12px;
}

/* Settings: the Updates section spans both columns under them. */
.interface-settings-panel .settings-section {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(172, 162, 122, 0.5);
}
.interface-settings-panel .update-status {
    margin: 4px 0 8px 0;
    color: rgb(240, 206, 128);
}
.interface-settings-panel .update-actions {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-bottom: 4px;
}
.interface-settings-panel .update-control {
    min-width: 128px;
    height: 36px;
    min-height: 36px;
    margin: 0 8px 6px 0;
    padding: 0 12px;
    font-size: 15px;
}

/* DIST-17: an update shown on a first menu's Settings: a gentle golden glow (tint and edge only, so nothing moves) and a
   small note that takes no space and no pointer. On the sign-in screen it sits under the button; in the main menu's
   column, inside the button on the right. */
.update-glow {
    -unity-background-image-tint-color: rgb(255, 226, 160);
    border-top-color: rgb(245, 205, 120);
    border-bottom-color: rgb(245, 205, 120);
    border-left-color: rgb(245, 205, 120);
    border-right-color: rgb(245, 205, 120);
    color: rgb(255, 232, 178);
}
.settings-update-note {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin: 3px 0 0 0;
    padding: 0;
    font-size: 12px;
    -unity-text-align: upper-center;
    white-space: nowrap;
    color: rgb(240, 206, 132);
}
.main-menu .settings-update-note {
    top: 0;
    bottom: 0;
    left: auto;
    right: 12px;
    margin: 0;
    -unity-text-align: middle-right;
}
